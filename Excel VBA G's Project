Sub NextQButton()

Dim origNextSectBtn, origNewQButn, origTextbox As Shape
Dim DDlistRow, totalDDLists, totalDDLists2, newTextboxTop As Integer
Dim newBtn, newBtn2 As Button
Dim ws As Worksheet

Set origNextSectBtn = ActiveSheet.Shapes("AddNewSectButn1")
Set origNewQButn = ActiveSheet.Shapes("NextQButn1")
Set origTextbox = ActiveSheet.Shapes("Sect1 Q1")

Set ws = Worksheets("Main Sheet")

' Get current Question and Section Counts
' -------------------------------------------------------------------
totalDDLists = FindListValidationCells                  ' Questions
totalSections = Worksheets("Sheet2").Range("C2").Value  ' Sections
' -------------------------------------------------------------------

If totalDDLists > 1 Then
    Set origNextSectBtn = ActiveSheet.Shapes("AddNewSectButn" & totalDDLists)
    Set origNewQButn = ActiveSheet.Shapes("NextQButn" & totalDDLists)
    Set origTextbox = ActiveSheet.Shapes("Sect1 Q" & totalDDLists)
End If

DDlistRow = origNextSectBtn.TopLeftCell.Row

Range("C" & DDlistRow).Select
    With Selection.Validation
        .Add Type:=xlValidateList, AlertStyle:=xlValidAlertStop, Operator:= _
        xlBetween, Formula1:="=Sheet2!$E$2#"
        .IgnoreBlank = True
        .InCellDropdown = True
        .InputTitle = ""
        .ErrorTitle = ""
        .InputMessage = ""
        .ErrorMessage = ""
        .ShowInput = True
        .ShowError = True
    End With
    
Range("C" & DDlistRow & ":L" & DDlistRow).Select
Selection.Merge True

newAddNextSectButn = origNextSectBtn.Top + 90.108
newAddNextQButn = origNewQButn.Top + 90.108

' origNextSectBtn.Delete

Set newBtn = ws.Buttons.Add(origNextSectBtn.Left, newAddNextSectButn, origNextSectBtn.Width, origNextSectBtn.Height)
Set newBtn2 = ws.Buttons.Add(origNewQButn.Left, newAddNextSectButn, origNewQButn.Width, origNewQButn.Height)

With newBtn ' Next Section Button
    .Caption = "+"
    .OnAction = "NextQButton"
    .Name = "AddNewSectButn" & (totalDDLists + 1)
End With

With newBtn2 ' Next Question Button
    .Caption = "+"
    .OnAction = "NextQButton"
    .Name = "NextQButn" & (totalDDLists + 1)
End With

newTextboxTop = origTextbox.Top + 90.108

Set newTextbox = ws.Shapes.AddTextbox(msoTextOrientationHorizontal, 40.49992, newTextboxTop, 431.25, 74.62504)

totalDDLists2 = FindListValidationCells

With newTextbox ' Textbox info
    .Name = "Sect" & totalSections & " Q" & totalDDLists2
End With

End Sub
