// Return number of combo box fields //
function getComboboxTotals(){var tD = 0;for( var i = 0; i < this.numFields; i++) {if(this.getField(this.getNthFieldName(i)).type == "combobox"){tD++;}}return tD;}


// Return number of button fields //
function getButtonTotals(){var tD = 0;for( var i = 0; i < this.numFields; i++) {if(this.getField(this.getNthFieldName(i)).type == "button"){tD++;}}return tD;}


// Return number of fields with name of "Section #" //
function getSectionFieldstotals() {
	var searchPattern = /^Section \d+$/;
	var sectionTotals = 0;
	for (var i = 0; i < this.numFields; i++) {
		var fname = this.getNthFieldName(i);
		if (searchPattern.test(fname)) {
			sectionTotals++;
		}
	}
	return sectionTotals;
}


// Return number of fields with name of "Section# Button#" //
function getSectionButtonFieldstotals() {var searchPattern = /Section\d+\sButton\d+/;var sectionButtonTotals = 0;for (var i = 0; i < this.numFields; i++) {var fname = this.getNthFieldName(i);if (searchPattern.test(fname)) {sectionButtonTotals++;}}return sectionButtonTotals;}


// Return number of fields with name of "Section# TextField#" //
function getTextFieldstotals() {var searchPattern = /Section\d+\sTextField\d+/;var sectionButtonTotals = 0;for (var i = 0; i < this.numFields; i++) {var fname = this.getNthFieldName(i);if (searchPattern.test(fname)) {sectionButtonTotals++;}}return sectionButtonTotals;}


