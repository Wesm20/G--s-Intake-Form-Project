// RUNS EVERY TIME DROPDOWN IS CHANGED
function createTextbox (){
	var tD = getComboboxTotals();
	console.println("tD createFirstTextBox: " + tD);
	var currDropdown = event.target.name.slice(-1);
	var currSections = getSectionFieldstotals();
	var textFieldSec1 = this.getField("Section" + currSections + " TextField" + currDropdown);
	var buttonFieldSec1 = this.getField("Section" + currSections + " Button" + currDropdown);
 
	var d = this.getField(event.target.name);
	if (d.value != "-Select Question-" && !textFieldSec1){
		if(this.getField("Add Next Section Button")){this.removeField("Add Next Section Button")}
    		var j = this.addField(("Section" + currSections + " TextField" + tD), "text", currPageNum, textField1);
		j.textSize = 9;j.alignment = "left";j.borderStyle = border.s;j.strokeColor = color.black;j.lineWidth = 1;j.multiline = true; 
		var m = this.addField('Add Next Section Button', 'button', currPageNum, addNewSectButton);
		m.borderStyle = border.s;m.strokeColor = color.black;m.lineWidth = 1;m.display = display.noPrint;m.buttonSetCaption("+");m.setAction("MouseDown", createNewSectionButton());
    		var b = this.addField(("Section" + currSections + " Button" + tD), 'button', currPageNum, buttonAddDD);
		b.borderStyle = border.s;b.strokeColor = color.black;b.lineWidth = 1;b.display = display.noPrint;b.buttonSetCaption("+");b.setAction("MouseDown",createButtonQuotes());
	} else if (d.value == "-Select Question-" && textFieldSec1) {
		this.removeField("Section1 TextField" + tD);
		this.removeField("Section1 Button" + tD);
		this.removeField("Add Next Section Button");
	}
}

