Sub ListShapesAndValidation()
    Dim shp As Shape
    Dim cell As Range
    Dim validationRange As Range
    Dim ws As Worksheet
    Set ws = ActiveSheet

    ' 1. Get all Shapes on the sheet
    Debug.Print "--- SHAPES ---"
    If ws.Shapes.Count > 0 Then
        For Each shp In ws.Shapes
            ' Prints Shape Name and its Top-Left cell address
            Debug.Print "Shape: " & shp.Name & " | Location: " & shp.TopLeftCell.Address _
            & " | Top: " & shp.Top & " | Left: " & shp.Left & " | Width: " & shp.Width _
            & " | Height: " & shp.Height
        Next shp
    Else
        Debug.Print "No shapes found."
    End If

    ' 2. Get all Data Validation on the sheet
    ' Debug.Print "--- DATA VALIDATION ---"
    On Error Resume Next ' Handle error if no validation exists
    Set validationRange = ws.UsedRange.SpecialCells(xlCellTypeAllValidation)
    On Error GoTo 0

