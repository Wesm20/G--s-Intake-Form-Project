End With

newTextboxTop = origTextbox.Top + 90.108
Set newTextbox = ws.Shapes.AddTextbox(msoTextOrientationHorizontal, 40.49992, (newTextboxTop + 30), 431.25, 74.62504)

With newTextbox ' Textbox info
    .Name = "Sect" & (totalSections + 1) & " Q1"
End With

' clear ("C" & DDlistRow)

