
Function FindListValidationCells() As Integer
' Get all drop down lists

Dim rng, vRng, cl As Range
Dim tC As Integer

Set rng = Worksheets("Main Sheet").Range("C1:C200")
Set vRng = rng.SpecialCells(xlCellTypeAllValidation)

tC = 0

For Each cl In rng
    If Intersect(cl, vRng) Is Nothing Then
    ElseIf cl.Validation.Type = 3 Then
        tC = tC + 1
    End If
Next

FindListValidationCells = tC

End Function

Function GetSectionTotal() As Integer
' Get total number of sections

Dim tS As Integer

Set rng = Worksheets("Main Sheet").Range("B1:B200")

tS = 0

For Each cell In rng
    If cell.Value Like "Section *" Then
        tS = tS + 1
    End If
Next

GetSectionTotal = tS
'Debug.Print "Total sections: " & tS
End Function
