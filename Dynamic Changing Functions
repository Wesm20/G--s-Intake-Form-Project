function getComboboxTotals(){
	var tD = 0;
	for ( var i = 0; i < n; i++) {
		var fname = this.getNthFieldName(i);
		var fieldType = this.getField(fname).type;
		if (fieldType == "combobox"){tD++;}}
	return tD;
}

