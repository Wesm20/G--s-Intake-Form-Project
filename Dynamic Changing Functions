function getSectionFieldstotals() {
    var searchPattern = /^Section \d+$/;
    for (var i = 0; i < this.numFields; i++) {
        var fname = this.getNthFieldName(i);
        if (searchPattern.test(fname)) {sectionTotals++;}}
	return sectionTotals;
}

function getSectionButtonFieldstotals() {
    var searchPattern = /^Section \d Button\d+$/;
    for (var i = 0; i < this.numFields; i++) {
        var fname = this.getNthFieldName(i);
        if (searchPattern.test(fname)) {sectionButtonTotals++;}}
	return sectionButtonTotals;
}

