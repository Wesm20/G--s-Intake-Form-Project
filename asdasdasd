Sub ResetDoc()

Dim clientName, clientID, sessionNum As String
Dim sessionDate As Date
Dim shp As Shape
varMsg = MsgBox("Would you like to reset all the sections?", vbOKCancel)

If varMsg = 1 Then
    Range("C3").value = ""
    Range("L3").value = ""
    If Range("P3").value <> "" Then
        AddTodayDate
    End If
    Range("U3").value = ""
    
    Range("B5").value = Worksheets("Sheet2").Range("I2").value
    Range("B5:F5").Merge Across = True
    
    Range("C6:Q6").Select
    Selection.Merge True
    Range("C6:Q6").value = Sheets("Sheet2").Range("E2").value
    
    ActiveSheet.Shapes.Range(Array("Sect1 Q1")).Select
    Selection.ShapeRange(1).TextFrame2.TextRange.Characters.Text = ""
    
    For Each shp In ActiveSheet.Shapes
        If shp.Name <> "AddNewSectButn1" And shp.Name <> "Sect1 Q1" And shp.Name <> "Save Sheet" _
            And shp.Name <> "Reset Sheet" And shp.Name <> "Add Today Date" Then
            shp.Delete
        End If
    Next shp
    'ActiveSheet.Buttons.Add(Left, Top, Width, Height)
    Set shp1 = Worksheets("Main Sheet").Buttons.Add(20.8815, 167.25, 17.1711, 10.5)
    With shp1
        .Caption = "+"
        .OnAction = "NextQButton"
        .Name = "NextQButn1"
    End With
    
    Set shp2 = Worksheets("Main Sheet").Buttons.Add(2.25, 167.25, 17.25, 10.5)
    With shp2
        .Caption = "++"
        .OnAction = "NextSectButton"
        .Name = "AddNewSectButn1"
    End With
    
    With shp2.Font
        .Name = "Aptos Narrow"
        .Size = 10
    End With
    
    With Range("C12:Q12")
        .UnMerge
        .ClearContents
        .Delete Shift:=xlToLeft
    End With
    
    With Range("B13:Q400")
        .UnMerge
        .ClearContents
        .Delete Shift:=xlToLeft
    End With
    
    Worksheets("Sheet2").Range("C2").value = 1
    ActiveWorkbook.Save

Else
    MsgBox "Did NOT delete sections"
End If

End Sub
