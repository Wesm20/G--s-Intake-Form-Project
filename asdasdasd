Sub clear(ByVal rng As String)
' Gets argument's values of dropdown list and deletes list
' Planned use: to remove dropdown once the next question button is pressed

Dim value, leftRng As String
If Not InStr(1, rng, ":") Then
    leftRng = rng
Else
    leftRng = Left(rng, (InStr(1, rng, ":") - 1))
End If

value = Range("" & leftRng & "").value
Range(leftRng).Delete

Range(rng).Merge Across:=True
Range(rng).value = value

End Sub

