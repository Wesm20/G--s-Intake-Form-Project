    Set ws = ActiveSheet
    
    ActiveWindow.View = xlPageBreakPreview
    
    For Each pb In ws.HPageBreaks
        Debug.Print "Page break found at Row: " & pb.Location.Row
    Next pb
    
    ActiveWindow.View = xlNormalView
    
    FindHorizontalPageBreaks = pb.Location.Row
End Function
